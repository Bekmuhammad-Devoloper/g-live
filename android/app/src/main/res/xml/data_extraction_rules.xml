<?xml version="1.0" encoding="utf-8"?>
<!--
    Ilova ma'lumotlari zaxiraga OLINMAYDI va boshqa telefonga
    ko'chirilMAYDI.

    Sabab: o'quvchining seansi (kirish cookie'si) WebView ichida saqlanadi.
    Uni Google Drive zaxirasiga chiqarish yoki yangi telefonga ko'chirish —
    boshqa odam o'sha seans bilan hisobga kirib qolishi demak.
    Foydalanuvchi yangi qurilmada oddiygina qaytadan kiradi.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
