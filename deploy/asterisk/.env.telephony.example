# GL-EDU telefoniya .env (bularni loyihaning asosiy .env fayliga qo'shing)

# Server / domen
PUBLIC_HOST=89.126.208.123          # public IPv4
PUBLIC_DOMAIN=crm.example.com       # HTTPS domen
SIP_DOMAIN=crm.example.com
WSS_URL=wss://crm.example.com/ws
# WS_URL=ws://89.126.208.123:8088/ws   # faqat HTTP (dev) uchun

# Asterisk AMI (backend AMI worker ulanadi)
ASTERISK_HOST=127.0.0.1
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER=glive_ami
ASTERISK_AMI_PASS=ami_secret_here
ASTERISK_RECORDING_DIR=/var/spool/asterisk/recording

# SIP trunk (provayderdan)
SIP_TRUNK_USERNAME=550552277
SIP_TRUNK_PASSWORD=trunk_password_here
SIP_TRUNK_CALLER_ID=550552277

# TURN/STUN (coturn)
TURN_USERNAME=turn_user
TURN_CREDENTIAL=turn_password

# Operator SIP parollari (User.sipExtension = operatorN ga mos)
SIP_OPERATOR1_PASS=op1_password
SIP_OPERATOR2_PASS=op2_password
SIP_OPERATOR3_PASS=op3_password
SIP_OPERATOR4_PASS=op4_password
SIP_OPERATOR5_PASS=op5_password
SIP_OPERATOR6_PASS=op6_password
SIP_OPERATOR7_PASS=op7_password
SIP_OPERATOR8_PASS=op8_password
SIP_OPERATOR9_PASS=op9_password
SIP_OPERATOR10_PASS=op10_password
