[Unit]
Description=GL EDU o'quv markazi: %i
After=network.target

[Service]
User=deploy
WorkingDirectory=/opt/gl-edu
ExecStartPre=+/usr/local/sbin/gl-center blanks %i
EnvironmentFile=-/opt/centers/%i/env.blank
EnvironmentFile=/opt/centers/%i/env
Environment=NODE_ENV=production
Environment=TZ=Asia/Tashkent
ExecStart=/usr/bin/npx next start -p ${PORT}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
