{
  "name": "gl-edu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/tunnel.mjs && next dev --turbopack",
    "dev:notunnel": "next dev --turbopack",
    "tunnel": "node scripts/tunnel.mjs",
    "build": "node scripts/check-dev-free.mjs && prisma generate && next build",
    "start": "next start",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && npm run db:seed",
    "postinstall": "prisma generate",
    "sync-cdr": "node --env-file=.env scripts/sync-cdr.mjs",
    "app:sync": "cap sync android",
    "app:icons": "node scripts/make-icons.mjs && npx -y @capacitor/assets@latest generate --android --assetPath capacitor/assets"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "jose": "^5.9.6",
    "jssip": "^3.13.8",
    "next": "^15.1.6",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "prisma": "^6.2.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
