generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Branch {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  lat       Float?
  lng       Float?
  radius    Int      @default(100)
  imageUrl  String?
  isActive  Boolean  @default(true)
  showInApply Boolean @default(true)
  applyCourses String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  leads    Lead[]
  students Student[]
  groups   Group[]
  marketItems MarketItem[]
  slots    BranchSlot[]
  staff    UserBranch[]
}

model UserBranch {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, branchId])
  @@index([branchId])
}

model BranchSlot {
  id        String   @id @default(cuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  room      String
  days      String
  startTime String
  endTime   String
  note      String?
  capacity  Int?
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads Lead[]

  @@index([branchId])
}

model StaffRole {
  id          String   @id @default(cuid())
  name        String
  description String?
  department  String?
  bossOnly    Boolean  @default(false)
  permissions String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Tag {
  id        String   @id @default(cuid())
  name      String
  code      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String    @id @default(cuid())
  fullName     String
  email        String    @unique
  phone        String?
  passwordHash String
  plainPassword String?
  role         String
  isActive     Boolean   @default(true)
  locale       String    @default("uz")
  gender       String?
  birthDate    DateTime?
  imageUrl     String?
  fiksa        Int       @default(0)
  kpiBonus     Int       @default(200000)
  position     String?
  sipExtension String?  @unique
  archivedAt    DateTime?
  archiveReason String?
  archiveNote   String?
  lastLoginAt  DateTime?
  gradedSubmissions Submission[] @relation("SubmissionGrader")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])
  branches UserBranch[]

  studentProfile Student?
  parentProfile  Parent?
  teacherGroups  Group[]  @relation("TeacherGroups")
  teacherChats   ChatMessage[] @relation("ChatTeacher")
  authoredChats  ChatMessage[] @relation("ChatAuthor")

  managedLeads  Lead[]         @relation("LeadManager")
  leadActivities LeadActivity[]

  auditLogs     AuditLog[]
  createdPayments Payment[]    @relation("PaymentAuthor")
  notifications Notification[]
  pushDevices   PushDevice[]

  assignedTasks Task[] @relation("TaskAssignee")
  authoredTasks Task[] @relation("TaskAuthor")

  salaries TeacherSalary[]

  calls Call[] @relation("CallOperator")

  expenses Expense[] @relation("ExpenseAuthor")
}

model TeacherSalary {
  id        String   @id @default(cuid())
  teacherId String
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  year      Int
  month     Int
  fiksa     Int      @default(0)
  bonus     Int      @default(0)
  penalty   Int      @default(0)
  kpi       Int      @default(0)
  lessons   Int      @default(0)
  students  Int      @default(0)
  closed    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teacherId, year, month])
  @@index([teacherId])
}

model Lead {
  id        String   @id @default(cuid())
  fullName  String
  phone     String
  email     String?
  telegram  String?

  source    String?
  utmSource   String?
  utmCampaign String?
  utmMedium   String?
  vacancyLinkId String?

  stage     String  @default("NEW")
  studyFormat String?
  age       Int?
  level     String?
  interestCourse String?
  budget    Int?
  preferredTime  String?
  note      String?
  lossReason String?

  branchId  String?
  branch    Branch? @relation(fields: [branchId], references: [id])

  managerId String?
  manager   User?   @relation("LeadManager", fields: [managerId], references: [id])

  studentId String?  @unique
  student   Student? @relation(fields: [studentId], references: [id])

  groupId   String?
  group     Group?   @relation(fields: [groupId], references: [id])
  enrollEditCount Int @default(0)

  kanbanColumnId String?
  testSet     String?
  testLevel   String?
  testPct     Int?
  testPassed  Boolean?
  testedAt    DateTime?
  archivedAt DateTime?
  archiveKind String?
  branchSlotId String?
  branchSlot   BranchSlot? @relation(fields: [branchSlotId], references: [id], onDelete: SetNull)

  activities LeadActivity[]
  calls      Call[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stage])
  @@index([kanbanColumnId])
  @@index([managerId])
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
  type      String
  result    String?
  nextStep  String?
  nextStepAt DateTime?
  createdAt DateTime @default(now())

  @@index([leadId])
}

model Student {
  id           String   @id @default(cuid())
  userId       String?  @unique
  user         User?    @relation(fields: [userId], references: [id])
  fullName     String
  phone        String?
  imageUrl     String?
  birthDate    DateTime?
  currentLevel String?
  age          Int?
  phone2       String?
  eduStatus    String   @default("WAITING")
  note         String?

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  lead        Lead?
  parents     StudentParent[]
  enrollments GroupStudent[]
  payments    Payment[]
  submissions Submission[]
  attendances Attendance[]
  examResults ExamResult[]
  certificates Certificate[]
  tasks       Task[]
  seasonalResults SeasonalResult[]
  marketOrders MarketOrder[]
  chatMessages ChatMessage[]
  notes        Note[]
  gameResults  GameResult[]
  challengesMade     GameChallenge[] @relation("ChallengeAuthor")
  challengesReceived GameChallenge[] @relation("ChallengeOpponent")
  challengeEntries   GameChallengeEntry[]
  lessonViews  LessonView[]
  vocabMastery VocabMastery[]
  skill        StudentSkill?
  levelUps     StudentLevelUp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Parent {
  id       String  @id @default(cuid())
  userId   String? @unique
  user     User?   @relation(fields: [userId], references: [id])
  fullName String
  phone    String?

  children StudentParent[]

  createdAt DateTime @default(now())
}

model StudentParent {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parentId  String
  parent    Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  relation  String?

  @@unique([studentId, parentId])
}

model Program {
  id          String  @id @default(cuid())
  name        String
  description String?
  banners     String?
  gradingType String  @default("PERCENT")
  isActive    Boolean @default(true)
  monthlyFee  Int?
  lessonsPerMonth Int @default(12)

  levels    Level[]
  groups    Group[]
  materials CourseMaterial[]
  courseLessons CourseLesson[]

  createdAt DateTime @default(now())
}

model CourseMaterial {
  id        String   @id @default(cuid())
  programId String
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  levelCode String?
  title     String
  kind      String   @default("LINK")
  url       String?
  note      String?
  createdAt DateTime @default(now())

  @@index([programId])
}

model CourseLesson {
  id         String   @id @default(cuid())
  programId  String
  program    Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  order      Int      @default(0)
  levelCode  String?
  title      String
  topic      String?
  videoUrl   String?
  videoPosterUrl String?
  vocabText  String?
  vocabFileUrl String?
  materialUrl String?
  assignment String?
  assignmentFileUrl String?
  homework   String?
  homeworkFileUrl String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  progress   GroupLessonProgress[]

  @@index([programId])
}

model GroupLessonProgress {
  id             String       @id @default(cuid())
  groupId        String
  group          Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  courseLessonId String
  courseLesson   CourseLesson @relation(fields: [courseLessonId], references: [id], onDelete: Cascade)
  taught         Boolean      @default(false)
  taughtAt       DateTime?
  updatedAt      DateTime     @updatedAt

  @@unique([groupId, courseLessonId])
  @@index([groupId])
}

model PortalBanner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  btnLabel  String?
  href      String?
  imageUrl  String?
  color     String   @default("#0e7490")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model PortalVideo {
  id        String   @id @default(cuid())
  title     String
  note      String?
  url       String
  kind      String   @default("VIDEO")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model LessonView {
  id             String   @id @default(cuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseLessonId String
  createdAt      DateTime @default(now())

  @@unique([studentId, courseLessonId])
  @@index([studentId])
}

model VocabMastery {
  id             String   @id @default(cuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseLessonId String
  words          Int      @default(0)
  createdAt      DateTime @default(now())

  @@unique([studentId, courseLessonId])
  @@index([studentId])
}

model StudentSkill {
  id           String   @id @default(cuid())
  studentId    String   @unique
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  words        Int      @default(0)
  reading      Int      @default(0)
  listening    Int      @default(0)
  speaking     Int      @default(0)
  /** Ilova oxirgi marta ochilgan / mashq qilingan vaqt */
  lastActiveAt DateTime @default(now())
  /** Qaysi vaqtgacha pasayish qo'llangan — ikki marta ayirilmasin */
  decayedAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  events SkillEvent[]
}

model SkillEvent {
  id        String       @id @default(cuid())
  skillId   String
  skill     StudentSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  key       String
  kind      String
  points    Int
  createdAt DateTime     @default(now())

  @@unique([skillId, key])
  @@index([skillId, createdAt])
}

model GameChallenge {
  id          String   @id @default(cuid())
  kind        String
  lobby       String
  seed        Int
  createdById String
  createdBy   Student  @relation("ChallengeAuthor", fields: [createdById], references: [id], onDelete: Cascade)
  opponentId  String?
  opponent    Student? @relation("ChallengeOpponent", fields: [opponentId], references: [id], onDelete: Cascade)
  groupId     String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  entries GameChallengeEntry[]

  @@index([opponentId])
  @@index([groupId])
  @@index([createdById])
}

model GameChallengeEntry {
  id          String        @id @default(cuid())
  challengeId String
  challenge   GameChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score       Int
  total       Int
  createdAt   DateTime      @default(now())

  @@unique([challengeId, studentId])
}

model GameResult {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  game      String
  mode      String
  score     Int
  total     Int
  won       Boolean
  createdAt DateTime @default(now())

  @@index([studentId, createdAt])
}

model StudentLevelUp {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromCode  String?
  toCode    String
  createdAt DateTime @default(now())

  @@index([studentId])
}

model StarRank {
  id        String  @id @default(cuid())
  nameUz    String
  nameRu    String
  nameEn    String
  nameDe    String
  stars     Int     @default(0)
  reward    Int     @default(0)
  color     String  @default("#0e7490")
  iconUrl   String?
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stars])
}

model StudyLevel {
  id        String  @id @default(cuid())
  code      String  @unique
  nameUz    String
  nameRu    String
  nameEn    String
  nameDe    String
  color     String  @default("#0e7490")
  bannerUrl String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model Level {
  id        String  @id @default(cuid())
  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  code      String
  name      String
  order     Int     @default(0)
  weeks     Int?
  academicHours Int?
  passScore Int?

  createdAt DateTime @default(now())

  @@unique([programId, code])
}

model Group {
  id        String   @id @default(cuid())
  name      String
  programId String
  program   Program  @relation(fields: [programId], references: [id])
  teacherId String?
  teacher   User?    @relation("TeacherGroups", fields: [teacherId], references: [id])
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  levelCode String?
  color     String?
  format    String   @default("OFFLINE")
  room      String?
  onlineLink String?
  status    String   @default("PLANNED")
  capacity  Int      @default(12)
  startDate DateTime?
  endDate   DateTime?
  weekdays  String?
  startTime String?
  endTime   String?
  note      String?
  monthlyFee Int?
  lessonsPerMonth Int?

  students    GroupStudent[]
  leads       Lead[]
  lessons     Lesson[]
  assignments Assignment[]
  tasks       Task[]
  seasonalAssessments SeasonalAssessment[]
  lessonProgress GroupLessonProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GroupStudent {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())
  isActive  Boolean  @default(true)
  leftAt    DateTime?

  @@unique([groupId, studentId])
}

model Lesson {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  topic     String?
  startsAt  DateTime
  endsAt    DateTime?
  qrToken   String?
  qrExpiresAt DateTime?

  attendances Attendance[]

  createdAt DateTime @default(now())

  @@index([groupId])
}

model Attendance {
  id        String   @id @default(cuid())
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status    String   @default("PRESENT")
  method    String   @default("QR")
  confirmed Boolean  @default(false)
  anomaly   Boolean  @default(false)
  markedAt  DateTime @default(now())

  @@unique([lessonId, studentId])
}

model AttendanceUnlock {
  id            String   @id @default(cuid())
  groupId       String
  date          String
  expiresAt     DateTime
  grantedById   String?
  grantedByName String?
  createdAt     DateTime @default(now())

  @@index([groupId, date])
}

model TeacherSchedule {
  id            String    @id @default(cuid())
  teacherId     String    @unique
  weekdays      String?
  startTime     String?
  endTime       String?
  monthlySalary Int       @default(0)
  startedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model TeacherAttendance {
  id        String   @id @default(cuid())
  teacherId String
  date      DateTime
  present   Boolean  @default(true)
  status    String?
  createdAt DateTime @default(now())

  @@unique([teacherId, date])
  @@index([teacherId])
}

model Assignment {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  courseLessonId String?
  title     String
  type      String   @default("TASK")
  skill     String?
  maxScore  Int      @default(100)
  dueAt     DateTime?
  note      String?

  submissions Submission[]

  createdAt DateTime @default(now())

  @@index([courseLessonId])
}

model Room {
  id        String   @id @default(cuid())
  name      String
  capacity  Int      @default(0)
  note      String?
  branchId  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Submission {
  id           String   @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  content      String?
  fileUrl      String?
  attempt      Int      @default(1)
  score        Int?
  teacherNote  String?
  status       String   @default("SUBMITTED")
  gradedById   String?
  gradedBy     User?    @relation("SubmissionGrader", fields: [gradedById], references: [id])
  gradedAt     DateTime?
  createdAt    DateTime @default(now())

  @@unique([assignmentId, studentId, attempt])
}

model Payment {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  amount      Int
  method      String
  purpose     String?
  status      String   @default("PENDING")
  isManual    Boolean  @default(false)
  transactionId String? @unique
  docNumber   String?
  receiptUrl  String?
  note        String?

  authorId    String?
  author      User?    @relation("PaymentAuthor", fields: [authorId], references: [id])

  cancelledAt DateTime?
  cancelReason String?

  promoCode   String?
  discount    Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([studentId])
  @@index([status])
  @@index([promoCode])
}

model PromoCode {
  id          String   @id @default(cuid())
  code        String   @unique
  discount    Int
  minCourses  Int?
  note        String?
  isActive    Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Exam {
  id        String   @id @default(cuid())
  title     String
  format    String   @default("INTERNAL")
  passScore Int      @default(60)
  createdAt DateTime @default(now())

  results ExamResult[]
}

model ExamResult {
  id        String   @id @default(cuid())
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score     Int?
  status    String   @default("PENDING")
  attempt   Int      @default(1)
  details   String?
  reviewer  String?
  note      String?
  takenAt   DateTime @default(now())
}

model BlockTest {
  id            String    @id @default(cuid())
  title         String
  type          String    @default("BLOCK")
  status        String    @default("PLANNED")
  date          DateTime?
  startTime     String?
  durationMin   Int       @default(60)
  responsibleId String?
  groupIds      String?
  branchId      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model TestType {
  id          String   @id @default(cuid())
  name        String
  code        String?
  durationMin Int      @default(0)
  courseIds   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Certificate {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  number     String   @unique
  programName String
  levelCode  String?
  result     String?
  qrCode     String   @unique
  status     String   @default("ISSUED")
  issuedAt   DateTime @default(now())
  issuedBy   String?
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  channel   String   @default("APP")
  event     String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model PushDevice {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String   @default("android")
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

model Task {
  id         String    @id @default(cuid())
  kind       String    @default("TASK")
  title      String
  note       String?
  tag        String?
  status     String    @default("OPEN")
  priority   String    @default("NORMAL")
  dueAt      DateTime?
  doneAt     DateTime?

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])
  authorId   String?
  author     User?   @relation("TaskAuthor", fields: [authorId], references: [id])

  studentId  String?
  student    Student? @relation(fields: [studentId], references: [id])
  groupId    String?
  group      Group?   @relation(fields: [groupId], references: [id])

  branchId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, status])
  @@index([assigneeId])
}

model SeasonalAssessment {
  id        String   @id @default(cuid())
  title     String
  season    String
  year      Int
  groupId   String?
  group     Group?   @relation(fields: [groupId], references: [id])
  levelCode String?
  skill     String?
  maxScore  Int      @default(100)
  passScore Int      @default(60)
  date      DateTime?
  status    String   @default("PLANNED")
  note      String?

  results   SeasonalResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([season, year])
  @@index([groupId])
}

model SeasonalResult {
  id           String   @id @default(cuid())
  assessmentId String
  assessment   SeasonalAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score        Int?
  grade        String?
  passed       Boolean?
  note         String?
  createdAt    DateTime @default(now())

  @@unique([assessmentId, studentId])
}

model ContractTemplate {
  id        String   @id @default(cuid())
  title     String
  type      String   @default("STANDARD")
  content   String?
  note      String?
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String?
  oldValue   String?
  newValue   String?
  reason     String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
}

model Call {
  id           String    @id @default(cuid())
  externalId   String?   @unique
  direction    String
  status       String    @default("ANSWERED")

  operatorId   String?
  operator     User?     @relation("CallOperator", fields: [operatorId], references: [id])
  operatorName String?

  leadId       String?
  lead         Lead?     @relation(fields: [leadId], references: [id])
  contactName  String?
  phone        String

  duration     Int       @default(0)
  recordingUrl String?
  comment      String?

  callbackStatus String  @default("NONE")
  callbackAt     DateTime?

  startedAt    DateTime  @default(now())
  answeredAt   DateTime?
  endedAt      DateTime?
  createdAt    DateTime  @default(now())

  @@index([startedAt])
  @@index([status])
  @@index([direction])
  @@index([operatorId])
  @@index([callbackStatus])
}

model Feedback {
  id         String    @id @default(cuid())
  teacherId  String
  studentId  String?
  groupId    String?
  lessonDate DateTime?
  comment    String?
  rating     Int       @default(5)
  createdAt  DateTime  @default(now())

  @@index([teacherId])
}

model Vacancy {
  id          String        @id @default(cuid())
  title       String
  company     String?
  country     String?
  countryCode String?
  jobTitle    String?
  salary      String?
  description String?
  questions   String?
  isActive    Boolean       @default(true)
  branchId    String?
  createdById String?
  createdByName String?
  links       VacancyLink[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([country])
}

model VacancyLink {
  id               String    @id @default(cuid())
  code             String    @unique
  name             String?
  platform         String    @default("other")
  vacancyId        String
  vacancy          Vacancy   @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  views            Int       @default(0)
  submissions      Int       @default(0)
  isActive         Boolean   @default(true)
  expiresAt        DateTime?
  maxSubmissions   Int?
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  lastViewedAt     DateTime?
  lastSubmissionAt DateTime?
  createdById      String?
  createdByName    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([vacancyId])
  @@index([platform])
  @@index([isActive])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ExpenseCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())

  expenses  Expense[]
}

model Expense {
  id         String   @id @default(cuid())
  name       String
  date       DateTime
  amount     Int
  method     String   @default("CASH")
  recipient  String?
  note       String?

  categoryId String?
  category   ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  branchId   String?

  authorId   String?
  author     User?    @relation("ExpenseAuthor", fields: [authorId], references: [id])

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([date])
  @@index([categoryId])
}

model SalaryRule {
  id         String   @id @default(cuid())
  scope      String   @default("ALL")
  amountType String   @default("FIXED")
  amount     Int
  isDefault  Boolean  @default(false)
  targetId   String?
  targetName String?
  groupId    String?
  groupName  String?
  createdById String?
  updatedById String?
  updatedAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([scope])
}

model MarketItem {
  id          String  @id @default(cuid())
  title       String
  description String?
  price       Int
  imageUrl    String?
  stock       Int?
  isActive    Boolean @default(true)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  orders    MarketOrder[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([isActive, branchId])
}

model MarketOrder {
  id     String @id @default(cuid())
  itemId String
  item   MarketItem @relation(fields: [itemId], references: [id])

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  price  Int
  status String @default("PENDING")
  note   String?

  createdAt   DateTime  @default(now())
  deliveredAt DateTime?

  @@index([studentId, status])
  @@index([status])
}

model ChatMessage {
  id String @id @default(cuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  teacherId String?
  teacher   User?   @relation("ChatTeacher", fields: [teacherId], references: [id])

  fromStudent Boolean
  authorId    String?
  author      User?   @relation("ChatAuthor", fields: [authorId], references: [id])

  text   String
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([studentId, createdAt])
  @@index([teacherId, fromStudent, readAt])
}

model Note {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  title   String
  content String  @default("")
  tags    String?
  kind    String  @default("NOTE")
  pinned  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, title])
  @@index([studentId, updatedAt])
}

model AiConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String
  messages  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}
