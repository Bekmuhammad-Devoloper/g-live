// Germaniya Live — O'quv markazini boshqarish tizimi
// Ma'lumotlar modeli (TZ 5-bo'lim asosida)
//
// Eslatma: MVP uchun SQLite ishlatilgan (o'rnatishsiz darhol ishlaydi).
// Production (PostgreSQL)'ga o'tish uchun: provider = "postgresql" qiling.
// Shuning uchun bu yerda enum ISHLATILMAGAN (statuslar String + lib/constants.ts da).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// FOYDALANUVCHILAR VA TASHKILIY TUZILMA
// ─────────────────────────────────────────────────────────────

model Branch {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  lat       Float? // manzil kenglik
  lng       Float? // manzil uzunlik
  radius    Int      @default(100) // geo-radius (metr) — davomat uchun
  imageUrl  String? // filial rasmi (data URL — galereyadan yuklangan)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  leads    Lead[]
  students Student[]
  groups   Group[]
  marketItems MarketItem[]

  // Finance V2
  financialAccounts FinancialAccount[]
  ledger            FinancialTransaction[]
  billingPolicies   BillingPolicy[]
  salaryPolicies    SalaryPolicy[]
  charges           StudentCharge[]
  payments          Payment[]
  refunds           Refund[]
  earnings          TeacherEarning[]
  payouts           SalaryPayout[]
  periodLocks       FinancePeriodLock[]
  slots    BranchSlot[]
}

// Filialdagi BO'SH XONA / BO'SH VAQT — filial administratori kiritadi,
// ROP lidlar kanbanidagi filial ustunida ko'radi (lidni qayerga yo'naltirishni
// bilish uchun). Erkin yozuv: xona nomi, kunlar, vaqt oralig'i, izoh.
model BranchSlot {
  id        String   @id @default(cuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  room      String // "3-xona"
  days      String // "Du, Chor, Ju"
  startTime String // "18:00"
  endTime   String // "19:30"
  note      String? // "A1 yangi guruh, 5 ta joy"
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
}

// Xodim rollari (boshqaruv)
model StaffRole {
  id          String   @id @default(cuid())
  name        String
  description String?
  department  String? // bo'lim (Boshqaruv, Sotuv bo'limi, Moliya bo'limi, ...)
  bossOnly    Boolean  @default(false) // faqat boss ko'ra oladi
  permissions String? // vergul bilan ajratilgan ruxsat kalitlari
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Teglar / yorliqlar (Nomi, Kodi, Holati)
model Tag {
  id        String   @id @default(cuid())
  name      String
  code      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String    @id @default(cuid())
  fullName     String
  email        String    @unique
  phone        String?
  passwordHash String
  plainPassword String? // parolni rahbariyat ko'rishi uchun ochiq nusxa (ichki admin funksiyasi)
  role         String // ROLES: STUDENT | PARENT | TEACHER | MANAGER | DEPUTY_DIRECTOR | DIRECTOR | ADMIN
  isActive     Boolean   @default(true)
  locale       String    @default("uz") // uz | ru
  gender       String? // MALE | FEMALE
  birthDate    DateTime? // tug'ilgan sana
  imageUrl     String? // profil rasmi (data URL — galereyadan yuklangan)
  fiksa        Int       @default(0) // o'qituvchi uchun belgilangan (fixed) oylik maosh (so'm)
  kpiBonus     Int       @default(200000) // operator KPI: har bir muvaffaqiyatli lid uchun bonus (so'm)
  position     String? // lavozim (erkin matn) — Sozlamalar/Xodimlar bo'limi
  sipExtension String?  @unique // telefoniya: operatorning SIP extension'i (masalan "operator3")
  archivedAt    DateTime? // arxivlangan (deaktivatsiya) sanasi
  archiveReason String? // arxivlash/o'chirish sababi
  archiveNote   String? // arxiv izohi
  lastLoginAt  DateTime?
  gradedSubmissions Submission[] @relation("SubmissionGrader")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  // Rolga bog'liq profillar
  studentProfile Student?
  parentProfile  Parent?
  teacherGroups  Group[]  @relation("TeacherGroups")
  teacherChats   ChatMessage[] @relation("ChatTeacher")
  authoredChats  ChatMessage[] @relation("ChatAuthor")

  // CRM
  managedLeads  Lead[]         @relation("LeadManager")
  leadActivities LeadActivity[]

  // Audit / to'lov / bildirishnoma
  auditLogs     AuditLog[]
  createdPayments Payment[]    @relation("PaymentAuthor")
  notifications Notification[]
  pushDevices   PushDevice[]

  // Topshiriq / eslatma
  assignedTasks Task[] @relation("TaskAssignee")
  authoredTasks Task[] @relation("TaskAuthor")

  // Oylik maosh yozuvlari (o'qituvchi)
  salaries TeacherSalary[]

  // Qo'ng'iroqlar markazi — operator sifatida
  calls Call[] @relation("CallOperator")

  // Moliya — kiritilgan xarajatlar
  expenses Expense[] @relation("ExpenseAuthor")

  // ── Finance V2 ──
  teacherAssignments       GroupTeacherAssignment[] @relation("TeacherAssignments")
  teacherEarnings          TeacherEarning[]         @relation("TeacherEarnings")
  salaryPeriods            SalaryPeriod[]           @relation("TeacherSalaryPeriods")
  salaryPayouts            SalaryPayout[]           @relation("TeacherPayouts")
  createdFinancialAccounts FinancialAccount[]       @relation("FinancialAccountCreatedBy")
  createdLedgerEntries     FinancialTransaction[]   @relation("LedgerCreatedBy")
  createdTransfers         Transfer[]               @relation("TransferCreatedBy")
  createdBillingPolicies   BillingPolicy[]          @relation("BillingPolicyCreatedBy")
  createdCharges           StudentCharge[]          @relation("ChargeCreatedBy")
  cancelledCharges         StudentCharge[]          @relation("ChargeCancelledBy")
  createdDiscounts         StudentDiscount[]        @relation("DiscountCreatedBy")
  createdAllocations       PaymentAllocation[]      @relation("AllocationCreatedBy")
  createdRefunds           Refund[]                 @relation("RefundCreatedBy")
  createdAssignments       GroupTeacherAssignment[] @relation("AssignmentCreatedBy")
  createdStatusHistory     StudentStatusHistory[]   @relation("StatusHistoryCreatedBy")
  createdGroupHistory      GroupStudentHistory[]    @relation("GroupStudentHistoryCreatedBy")
  createdSalaryPolicies    SalaryPolicy[]           @relation("SalaryPolicyCreatedBy")
  createdSalaryRules       SalaryRule[]             @relation("SalaryRuleCreatedBy")
  reviewedEarnings         TeacherEarning[]         @relation("EarningReviewedBy")
  createdEarnings          TeacherEarning[]         @relation("EarningCreatedBy")
  approvedPeriods          SalaryPeriod[]           @relation("PeriodApprovedBy")
  closedPeriods            SalaryPeriod[]           @relation("PeriodClosedBy")
  reopenedPeriods          SalaryPeriod[]           @relation("PeriodReopenedBy")
  createdPayouts           SalaryPayout[]           @relation("PayoutCreatedBy")
  lockedPeriods            FinancePeriodLock[]      @relation("PeriodLockedBy")
  reopenedPeriodLocks      FinancePeriodLock[]      @relation("PeriodLockReopenedBy")
}

// O'qituvchi oylik maoshi — har oy alohida yozuv (yil+oy bo'yicha).
// Yangi oy = yangi yozuv (0'dan boshlanadi); eski oylar tarix sifatida saqlanadi.
model TeacherSalary {
  id        String   @id @default(cuid())
  teacherId String
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  year      Int
  month     Int // 1-12
  fiksa     Int      @default(0) // shu oydagi belgilangan maosh
  bonus     Int      @default(0)
  penalty   Int      @default(0) // ushlanma
  kpi       Int      @default(0) // KPI bonus summasi (so'm), jamiga qo'shiladi
  lessons   Int      @default(0) // shu oyda o'tilgan darslar
  students  Int      @default(0) // faol o'quvchilar
  closed    Boolean  @default(false) // oy yopilgan (tarix) bo'lsa true
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Finance V2: cutover'dan keyin faqat o'qish (legacy). Backfill shu qatordan SalaryPeriod{source LEGACY} yaratadi.
  migratedPeriod SalaryPeriod?

  @@unique([teacherId, year, month])
  @@index([teacherId])
}

// ─────────────────────────────────────────────────────────────
// CRM — LID VA SAVDO VORONKASI
// ─────────────────────────────────────────────────────────────

model Lead {
  id        String   @id @default(cuid())
  fullName  String
  phone     String
  email     String?
  telegram  String?

  source    String? // sayt | ilova | telegram | telefon | reklama | tashrif ...
  utmSource   String?
  utmCampaign String?
  utmMedium   String?
  vacancyLinkId String? // qaysi maxsus havoladan (Havolalar moduli) kelgan

  stage     String  @default("NEW") // LEAD_STAGES (lib/constants.ts)
  studyFormat String? // ta'lim shakli: ONLINE | OFFLINE — ochiq ariza formasida tanlanadi
  age       Int? // yoshi — ariza formasida so'raladi
  level     String? // hozirgi daraja (A1, B2 ...) — ariza formasida so'raladi
  interestCourse String?
  budget    Int? // taxminiy byudjet (so'm)
  preferredTime  String?
  note      String?
  lossReason String? // yo'qotilgan bo'lsa sabab

  branchId  String?
  branch    Branch? @relation(fields: [branchId], references: [id])

  managerId String?
  manager   User?   @relation("LeadManager", fields: [managerId], references: [id])

  // Konvertatsiyadan keyin bog'lanadigan o'quvchi
  studentId String?  @unique
  student   Student? @relation(fields: [studentId], references: [id])

  // "Qabul qilindi" (WON) uchun MAJBURIY guruh biriktiruvi.
  // Guruh kursga (Program) tegishli — shuning uchun kurs alohida saqlanmaydi.
  groupId   String?
  group     Group?   @relation(fields: [groupId], references: [id])
  // Guruhni keyin FAQAT BIR MARTA o'zgartirish mumkin (0 = hali o'zgartirilmagan)
  enrollEditCount Int @default(0)

  // Kanbandagi oddiy nomli ustun (Setting "crm.kanbanColumns" dagi id).
  // Bosqichga ta'sir qilmaydi — faqat qaysi ustunda ko'rinishini belgilaydi;
  // standart ustunga ko'chirilsa yoki guruhga yozilsa tozalanadi.
  kanbanColumnId String?

  activities LeadActivity[]
  calls      Call[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stage])
  @@index([kanbanColumnId])
  @@index([managerId])
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
  type      String // call | message | meeting | note | stage_change | test
  result    String?
  nextStep  String?
  nextStepAt DateTime?
  createdAt DateTime @default(now())

  @@index([leadId])
}

// ─────────────────────────────────────────────────────────────
// O'QUVCHI / OTA-ONA
// ─────────────────────────────────────────────────────────────

model Student {
  id           String   @id @default(cuid())
  userId       String?  @unique
  user         User?    @relation(fields: [userId], references: [id])
  fullName     String
  phone        String?
  imageUrl     String? // o'quvchi profil rasmi (data URL)
  birthDate    DateTime?
  currentLevel String? // masalan A1.2
  age          Int? // yoshi (ixtiyoriy)
  phone2       String? // qo'shimcha telefon (ixtiyoriy)
  eduStatus    String   @default("WAITING") // EDU_STATUSES (lib/constants.ts)
  note         String? // o'quvchi haqida izoh — profil, ro'yxat va kartochkada ko'rinadi

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  lead        Lead?
  parents     StudentParent[]
  enrollments GroupStudent[]
  payments    Payment[]
  submissions Submission[]
  attendances Attendance[]
  examResults ExamResult[]
  certificates Certificate[]
  tasks       Task[]
  seasonalResults SeasonalResult[]
  marketOrders MarketOrder[]
  chatMessages ChatMessage[]
  notes        Note[]
  gameResults  GameResult[]
  challengesMade     GameChallenge[] @relation("ChallengeAuthor")
  challengesReceived GameChallenge[] @relation("ChallengeOpponent")
  challengeEntries   GameChallengeEntry[]
  lessonViews  LessonView[]
  vocabMastery VocabMastery[]
  skill        StudentSkill?
  levelUps     StudentLevelUp[]

  // Finance V2
  charges        StudentCharge[]
  discounts      StudentDiscount[]
  statusHistory  StudentStatusHistory[]
  groupHistory   GroupStudentHistory[]
  refunds        Refund[]
  earnings       TeacherEarning[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Parent {
  id       String  @id @default(cuid())
  userId   String? @unique
  user     User?   @relation(fields: [userId], references: [id])
  fullName String
  phone    String?

  children StudentParent[]

  createdAt DateTime @default(now())
}

// O'quvchi ↔ ota-ona bog'lanishi (ko'p-ko'pga)
model StudentParent {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parentId  String
  parent    Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  relation  String? // ota | ona | vasiy ...

  @@unique([studentId, parentId])
}

// ─────────────────────────────────────────────────────────────
// O'QUV DASTURI, GURUH, DARS
// ─────────────────────────────────────────────────────────────

model Program {
  id          String  @id @default(cuid())
  name        String // masalan "Nemis tili A1-B2"
  description String?
  banners     String? // JSON massiv — kurs bannerlari (data URL)
  gradingType String  @default("PERCENT") // PERCENT | POINTS | FIVE | PASS_FAIL
  isActive    Boolean @default(true)
  // Kurs oylik to'lovi (so'm). Guruhda o'z narxi bo'lmasa shu ishlatiladi.
  // O'quvchi guruhga qo'shilgan oydan boshlab har oy shu summa hisoblanadi.
  monthlyFee  Int?

  levels    Level[]
  groups    Group[]
  materials CourseMaterial[]
  courseLessons CourseLesson[]

  createdAt DateTime @default(now())

  // Finance V2
  charges  StudentCharge[]
  earnings TeacherEarning[]
}

// Kurs (dastur) materiallari — havola, fayl, video, hujjat
model CourseMaterial {
  id        String   @id @default(cuid())
  programId String
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  levelCode String? // ixtiyoriy — qaysi darajaga (denormalizatsiya)
  title     String
  kind      String   @default("LINK") // LINK | VIDEO | FILE | DOC
  url       String? // havola yoki fayl (data URL)
  note      String?
  createdAt DateTime @default(now())

  @@index([programId])
}

// Kurs dars rejasi (syllabus) — ketma-ket darslar: mavzu, video, topshiriq, uy vazifasi
model CourseLesson {
  id         String   @id @default(cuid())
  programId  String
  program    Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  order      Int      @default(0) // ketma-ketlik
  levelCode  String? // qaysi darajaga tegishli (A1, A2, B1 ...) — o'quvchi portalida bo'limlarga ajratish uchun
  title      String // dars nomi
  topic      String? // mavzu tafsiloti
  videoUrl   String? // yuklangan video yo'li (/uploads/...)
  vocabText  String? // lug'at, qo'lda yozilgan: "der Hund - it" (har qatorda bitta)
  vocabFileUrl String? // lug'at fayli (pdf/word/txt) — o'quvchi ilovasidagi "Lug'at" bo'limida ochiladi
  materialUrl String? // qo'shimcha material/fayl yo'li
  assignment String? // dars topshirig'i (matn)
  assignmentFileUrl String? // topshiriq uchun yuklangan fayl
  homework   String? // uy vazifasi (matn)
  homeworkFileUrl String? // uy vazifasi uchun yuklangan fayl
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  progress   GroupLessonProgress[]

  @@index([programId])
}

// Har guruh qaysi darsni o'tganini belgilaydi (kurs shabloniga nisbatan)
model GroupLessonProgress {
  id             String       @id @default(cuid())
  groupId        String
  group          Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  courseLessonId String
  courseLesson   CourseLesson @relation(fields: [courseLessonId], references: [id], onDelete: Cascade)
  taught         Boolean      @default(false)
  taughtAt       DateTime?
  updatedAt      DateTime     @updatedAt

  @@unique([groupId, courseLessonId])
  @@index([groupId])
}

// ─────────────────────────────────────────────────────────────
// DARAJA KATALOGI — Sozlamalar > Darajalar
// A1, A2, B1 ... butun tizim bo'ylab bitta ro'yxatdan olinadi:
// o'quvchi ilovasidagi kurslar, dars oynasidagi tanlov, ariza formasi.
// Pastdagi `Level` modeli BOSHQA narsa — u aynan bitta kursdagi
// darajaning reja ko'rsatkichlari (hafta, akademik soat, o'tish balli).
// ─────────────────────────────────────────────────────────────
// ─────────────────────────────────────────────────────────────
// TANGA MANBALARI
// Dars qatnashuvi va vazifalar allaqachon boshqa jadvallarda bor;
// bu ikkitasi yetishmayotgan manbalarni yozib boradi.
// ─────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────
// O'QUVCHI BOSH SAHIFASI MAZMUNI
// Direktor va menejer Sozlamalar > Bosh sahifa bo'limidan boshqaradi.
// ─────────────────────────────────────────────────────────────

// Reklama banneri (karusel)
model PortalBanner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  btnLabel  String?
  href      String? // ichki yo'l (/student/kurse) yoki tashqi havola
  imageUrl  String? // yuklangan rasm; bo'lmasa rangli gradient
  color     String   @default("#0e7490")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

// Video va podkastlar — YouTube havolalari
model PortalVideo {
  id        String   @id @default(cuid())
  title     String
  note      String?
  url       String // YouTube/Vimeo havolasi yoki /uploads/... fayl
  kind      String   @default("VIDEO") // VIDEO | PODCAST
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

// Dars videosini ko'rgani — har darsga BIR marta yoziladi
model LessonView {
  id             String   @id @default(cuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseLessonId String
  createdAt      DateTime @default(now())

  @@unique([studentId, courseLessonId])
  @@index([studentId])
}

// Darsning lug'ati o'zlashtirilgani.
//
// O'quvchi mashqda darsdagi HAR BIR so'zni to'g'ri tanlab chiqqanda bitta
// yozuv qo'shiladi. Ilgari lug'at faqat o'qituvchi darsni "o'tildi" deb
// belgilaganda 100% bo'lardi — o'quvchining o'zi qilgan ishi hech qayerda
// ko'rinmasdi va u kutib o'tirishdan boshqa ilojsiz edi.
//
// `words` — o'sha paytdagi so'zlar soni. Ustoz keyin so'z qo'shsa, eski
// natija qancha so'zdan olinganini bilib turamiz.
model VocabMastery {
  id             String   @id @default(cuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseLessonId String
  words          Int      @default(0)
  createdAt      DateTime @default(now())

  @@unique([studentId, courseLessonId])
  @@index([studentId])
}

// O'quvchining to'rt ko'nikmasi (bosh sahifadagi plitkalar): So'zlar,
// O'qish, Tinglash, Gapirish — 0..100.
//
// Ilgari bu foizlar boshqa narsalardan olinardi (imtihon o'rtachasi,
// davomat, dastur jarayoni) va hech qachon pasaymasdi. Endi ular
// MASHQ bilan o'sadi (har to'g'ri bajarilgan bosqich/vazifa — ball) va
// FAOLSIZLIK bilan pasayadi: ilova bir kun ochilmasa — kamayadi, ikki kun
// — yana. Pasayish qaytmaydi, faqat yangi mashq bilan tiklanadi.
//
// Qiymat SAQLANADI (tanga kabi qayta hisoblanmaydi), chunki pasayish
// tarixga bog'liq: "3 kun kirmadi, keyin qaytdi" holatini hodisalardan
// qayta hisoblab bo'lmaydi.
model StudentSkill {
  id           String   @id @default(cuid())
  studentId    String   @unique
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  words        Int      @default(0)
  reading      Int      @default(0)
  listening    Int      @default(0)
  speaking     Int      @default(0)
  /** Ilova oxirgi marta ochilgan / mashq qilingan vaqt */
  lastActiveAt DateTime @default(now())
  /** Qaysi vaqtgacha pasayish qo'llangan — ikki marta ayirilmasin */
  decayedAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  events SkillEvent[]
}

// Ball berilgan hodisa. `key` bir marta beriladigan narsani belgilaydi
// ("vocab:<dars>:s1" — shu darsning 1-bosqichi): xuddi shu mashqni qayta-
// qayta bajarib ball yig'ib bo'lmaydi.
model SkillEvent {
  id        String       @id @default(cuid())
  skillId   String
  skill     StudentSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  key       String
  kind      String // words | reading | listening | speaking
  points    Int
  createdAt DateTime     @default(now())

  @@unique([skillId, key])
  @@index([skillId, createdAt])
}

// "Jang" chaqiruvi — duel (bir ga bir) yoki guruhli o'yin.
// Ikkala o'yinchi BIR XIL savollarni oladi (seed bir xil), lekin bir vaqtda
// o'ynashi shart emas: kim qachon ulgursa o'shanda o'ynaydi, natija ikkalasi
// ham tugatgach aniqlanadi.
model GameChallenge {
  id          String   @id @default(cuid())
  kind        String // DUEL | GROUP
  lobby       String // vocabulary | wordgame | crossword | grammar
  seed        Int // savollar shu raqamdan hosil bo'ladi
  createdById String
  createdBy   Student  @relation("ChallengeAuthor", fields: [createdById], references: [id], onDelete: Cascade)
  opponentId  String? // DUEL uchun
  opponent    Student? @relation("ChallengeOpponent", fields: [opponentId], references: [id], onDelete: Cascade)
  groupId     String? // GROUP uchun
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  entries GameChallengeEntry[]

  @@index([opponentId])
  @@index([groupId])
  @@index([createdById])
}

// Chaqiruvdagi bitta o'yinchining natijasi
model GameChallengeEntry {
  id          String        @id @default(cuid())
  challengeId String
  challenge   GameChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score       Int
  total       Int
  createdAt   DateTime      @default(now())

  @@unique([challengeId, studentId])
}

// "Jang" bo'limidagi o'yin natijasi
model GameResult {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  game      String // vocabulary | wordgame | crossword
  mode      String // ai | duel | group
  score     Int // to'g'ri javoblar
  total     Int // jami savollar
  won       Boolean
  createdAt DateTime @default(now())

  @@index([studentId, createdAt])
}

// Daraja ko'tarilishi (A1 -> A2 ...) — faqat YUQORIGA siljish yoziladi
model StudentLevelUp {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromCode  String?
  toCode    String
  createdAt DateTime @default(now())

  @@index([studentId])
}

// Yulduz darajalari — o'quvchi yulduz yig'ib ko'tariladigan pog'onalar.
// StudyLevel (A1/A2) dan MUTLAQO boshqa narsa: u kurs darajasi, bu esa
// o'yin darajasi. Har pog'onaga chiqqanda `reward` tanga beriladi.
// Boshqaruvi: Sozlamalar > Yulduz darajalari (direktor va menejer).
model StarRank {
  id        String  @id @default(cuid())
  nameUz    String
  nameRu    String
  nameEn    String
  nameDe    String
  stars     Int     @default(0) // shu pog'onaga chiqish uchun kerak yulduz
  reward    Int     @default(0) // ko'tarilgani uchun beriladigan tanga
  color     String  @default("#0e7490")
  iconUrl   String? // ma'muriyat yuklagan belgi (bo'lmasa — pog'ona raqami)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stars])
}

model StudyLevel {
  id        String  @id @default(cuid())
  code      String  @unique // A1, A2, B1.1 ...
  nameUz    String
  nameRu    String
  nameEn    String
  nameDe    String
  color     String  @default("#0e7490") // kartochka gradienti shundan hosil bo'ladi
  bannerUrl String? // ilovada kartochka o'rniga ko'rinadigan rasm
  sortOrder Int     @default(0)
  isActive  Boolean @default(true) // o'chirilgani ilovada ko'rinmaydi

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model Level {
  id        String  @id @default(cuid())
  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  code      String // A1.1, A1.2 ...
  name      String
  order     Int     @default(0)
  weeks     Int? // davomiylik (hafta) — sozlanadi
  academicHours Int? // akademik soat
  passScore Int? // o'tish balli (foiz)

  createdAt DateTime @default(now())

  @@unique([programId, code])
}

model Group {
  id        String   @id @default(cuid())
  name      String
  programId String
  program   Program  @relation(fields: [programId], references: [id])
  teacherId String?
  teacher   User?    @relation("TeacherGroups", fields: [teacherId], references: [id])
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  levelCode String? // joriy daraja
  color     String? // guruh rangi (hex, masalan #3b82f6)
  format    String   @default("OFFLINE") // ONLINE | OFFLINE | HYBRID (o'quv shakli)
  room      String?
  onlineLink String?
  status    String   @default("PLANNED") // PLANNED | ACTIVE | FINISHED | CANCELLED
  capacity  Int      @default(12)
  startDate DateTime?
  endDate   DateTime? // guruh tugash sanasi
  weekdays  String? // dars kunlari: vergul bilan 1..7 (Du=1 ... Ya=7), masalan "1,3,5"
  startTime String? // dars boshlanish vaqti "HH:mm"
  endTime   String? // dars tugash vaqti "HH:mm"
  note      String? // guruh haqida izoh/kament — guruh ma'lumoti ko'rinadigan hamma joyda chiqadi
  monthlyFee Int? // guruhning oylik to'lovi (so'm); bo'lmasa kurs narxi olinadi

  students    GroupStudent[]
  leads       Lead[] // shu guruhga yo'naltirilgan lidlar
  lessons     Lesson[]
  assignments Assignment[]
  tasks       Task[]
  seasonalAssessments SeasonalAssessment[]
  lessonProgress GroupLessonProgress[]

  // Finance V2 — teacherId joriy holat; tarix teacherAssignments'da
  teacherAssignments GroupTeacherAssignment[]
  charges            StudentCharge[]
  discounts          StudentDiscount[]
  earnings           TeacherEarning[]
  studentHistory     GroupStudentHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GroupStudent {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())
  isActive  Boolean  @default(true)
  leftAt    DateTime? // guruhdan chiqarilgan sana — to'lov hisobi shu oygacha yuritiladi

  @@unique([groupId, studentId])
}

model Lesson {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  topic     String?
  startsAt  DateTime
  endsAt    DateTime?
  // QR-davomat uchun: har dars uchun dinamik token va amal muddati
  qrToken   String?
  qrExpiresAt DateTime?

  attendances Attendance[]

  createdAt DateTime @default(now())

  @@index([groupId])
}

model Attendance {
  id        String   @id @default(cuid())
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status    String   @default("PRESENT") // PRESENT | LATE | ABSENT | EXCUSED | ONLINE | MAKEUP
  method    String   @default("QR") // QR | MANUAL
  confirmed Boolean  @default(false) // o'qituvchi yakuniy ro'yxatni tasdiqlaydi
  anomaly   Boolean  @default(false) // boshqa qurilma/joydan skanerlash
  markedAt  DateTime @default(now())

  @@unique([lessonId, studentId])
}

// Yopilgan (dars + 3 soat o'tgan) davomatni vaqtincha ochish ruxsati.
// Menejer / Direktor / o'rinbosari / ROP beradi; muddati tugagach yana yopiladi.
model AttendanceUnlock {
  id            String   @id @default(cuid())
  groupId       String
  date          String // "YYYY-MM-DD" — qaysi kun davomati ochilgan
  expiresAt     DateTime // shu vaqtgacha tahrirlash mumkin
  grantedById   String?
  grantedByName String?
  createdAt     DateTime @default(now())

  @@index([groupId, date])
}

// O'qituvchi ish jadvali (ustozlar ish jadvali)
model TeacherSchedule {
  id            String    @id @default(cuid())
  teacherId     String    @unique
  weekdays      String? // "1,2,3,4,5" (Du=1 ... Ya=7)
  startTime     String? // "HH:mm"
  endTime       String? // "HH:mm"
  monthlySalary Int       @default(0)
  startedAt     DateTime? // ish faoliyatining boshlanishi
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// O'qituvchi kunlik davomati
model TeacherAttendance {
  id        String   @id @default(cuid())
  teacherId String
  date      DateTime // kun (00:00)
  present   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([teacherId, date])
  @@index([teacherId])
}

// ─────────────────────────────────────────────────────────────
// UY VAZIFA / BAHOLASH
// ─────────────────────────────────────────────────────────────

model Assignment {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  // Vazifa qaysi darsga tegishli — o'quvchi ilovasida shu dars sahifasida
  // ko'rinadi. Bo'sh bo'lsa faqat umumiy "Mashq" ro'yxatida turadi.
  courseLessonId String?
  title     String
  type      String   @default("TASK") // TASK | EXAM | HOMEWORK | TEST
  skill     String? // SPEAKING | WRITING | READING | LISTENING | GRAMMAR
  maxScore  Int      @default(100)
  dueAt     DateTime?
  note      String? // izoh

  submissions Submission[]

  createdAt DateTime @default(now())

  @@index([courseLessonId])
}

model Room {
  id        String   @id @default(cuid())
  name      String
  capacity  Int      @default(0)
  note      String?
  branchId  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Submission {
  id           String   @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  content      String? // matn yoki havola (masalan github)
  fileUrl      String? // yuklangan fayl (/uploads/...)
  attempt      Int      @default(1)
  score        Int?
  teacherNote  String? // past baho uchun majburiy izoh
  status       String   @default("SUBMITTED") // SUBMITTED | GRADED | RETURNED
  gradedById   String? // kim tekshirgani
  gradedBy     User?    @relation("SubmissionGrader", fields: [gradedById], references: [id])
  gradedAt     DateTime?
  createdAt    DateTime @default(now())

  @@unique([assignmentId, studentId, attempt])
}

// ─────────────────────────────────────────────────────────────
// TO'LOV VA MOLIYA
// ─────────────────────────────────────────────────────────────

model Payment {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  amount      Int // so'm (butun)
  method      String // CLICK | PAYME | UZUM | CASH | CARD | TRANSFER ...
  purpose     String? // kurs to'lovi | qarz | ...
  status      String   @default("PENDING") // PENDING | PAID | REFUNDED | CANCELLED | (V2) REVERSED — correction bilan almashtirilgan
  isManual    Boolean  @default(false) // qo'lda kiritilgan
  transactionId String? @unique // provayder tranzaksiya ID (dublikat oldini olish)
  docNumber   String? // chek/hujjat raqami
  receiptUrl  String?
  note        String?

  authorId    String? // qo'lda kiritgan xodim
  author      User?    @relation("PaymentAuthor", fields: [authorId], references: [id])

  cancelledAt DateTime?
  cancelReason String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ── Finance V2 (additive; eski qatorlarda null — backfill Phase 2) ──
  receivedAt         DateTime? // pul REAL kelgan vaqt (createdAt emas); maosh earning oyi shundan
  branchId           String?
  branch             Branch?  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  financialAccountId String? // qaysi kassaga tushgan
  financialAccount   FinancialAccount? @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  idempotencyKey     String?  @unique // ikki marta bosishdan himoya
  // Eski semantika belgisi: "DEBT" (status=PENDING — qarz edi), "REFUND" (status=REFUNDED — yechim edi), null = real pul
  legacyRole         String?
  postedAt           DateTime? // ledgerga yozilgan vaqt (V2)
  reversalOfId       String?  @unique // correction: bu to'lov eskisini almashtiradi (eskisi status=REVERSED)
  reversalOf         Payment? @relation("PaymentReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy         Payment? @relation("PaymentReversal")

  allocations  PaymentAllocation[]
  refunds      Refund[]         @relation("PaymentRefunds")
  legacyRefund Refund?          @relation("RefundLegacyPayment")
  legacyCharge StudentCharge?   @relation("ChargeLegacyPayment")
  earnings     TeacherEarning[] @relation("PaymentEarnings")

  @@index([studentId])
  @@index([status])
  @@index([receivedAt])
  @@index([branchId, receivedAt])
}

// ─────────────────────────────────────────────────────────────
// IMTIHON VA SERTIFIKAT
// ─────────────────────────────────────────────────────────────

model Exam {
  id        String   @id @default(cuid())
  title     String
  format    String   @default("INTERNAL") // INTERNAL | GOETHE | TELC | TESTDAF ...
  passScore Int      @default(60)
  createdAt DateTime @default(now())

  results ExamResult[]
}

model ExamResult {
  id        String   @id @default(cuid())
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score     Int?
  status    String   @default("PENDING") // PENDING | PASSED | FAILED
  attempt   Int      @default(1)
  details   String? // JSON (bo'limlar bo'yicha ballar)
  reviewer  String?
  note      String?
  takenAt   DateTime @default(now())
}

// Blok test — imtihon hodisasi (kirish/blok/yakuniy)
model BlockTest {
  id            String    @id @default(cuid())
  title         String
  type          String    @default("BLOCK") // KIRISH | BLOCK | YAKUNIY
  status        String    @default("PLANNED") // PLANNED | ACTIVE | FINISHED
  date          DateTime?
  startTime     String? // "HH:mm"
  durationMin   Int       @default(60)
  responsibleId String? // mas'ul xodim (User id)
  groupIds      String? // vergul bilan Group id lar
  // Qaysi filial testi (filial izolyatsiyasi uchun; eski yozuvlarda null)
  branchId      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Test turi (shablon)
model TestType {
  id          String   @id @default(cuid())
  name        String
  code        String?
  durationMin Int      @default(0)
  courseIds   String? // vergul bilan Program id lar
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Certificate {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  number     String   @unique // noyob raqam
  programName String
  levelCode  String?
  result     String?
  qrCode     String   @unique // tekshiruv uchun (URL/token)
  status     String   @default("ISSUED") // ISSUED | REPLACED | REVOKED
  issuedAt   DateTime @default(now())
  issuedBy   String?
}

// ─────────────────────────────────────────────────────────────
// BILDIRISHNOMA VA AUDIT
// ─────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  channel   String   @default("APP") // APP | PUSH | TELEGRAM | EMAIL | SMS
  event     String? // hodisa turi
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

// Android ilovasidagi qurilma — push bildirishnoma yuborish uchun.
//
// Bitta odamda bir nechta qurilma bo'lishi mumkin (telefon, planshet), shu
// sabab userId bo'yicha ko'plik. `token` esa Firebase bergan manzil: u
// qurilmaga emas, ILOVA O'RNATMASIGA tegishli va vaqti-vaqti bilan
// yangilanadi — shuning uchun unique va yangilanganda upsert qilinadi.
//
// Firebase "token yaroqsiz" deb javob qaytarsa yozuv o'chiriladi: ilova
// o'chirilgan yoki ma'lumotlari tozalangan degani.
model PushDevice {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String   @default("android") // android | ios
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

// Topshiriq va eslatma (bitta model, kind bilan ajratiladi)
model Task {
  id         String    @id @default(cuid())
  kind       String    @default("TASK") // TASK | REMINDER
  title      String
  note       String?
  tag        String? // teg (masalan "to'lov", "qo'ng'iroq")
  status     String    @default("OPEN") // OPEN | DONE
  priority   String    @default("NORMAL") // LOW | NORMAL | HIGH
  dueAt      DateTime?
  doneAt     DateTime?

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])
  authorId   String?
  author     User?   @relation("TaskAuthor", fields: [authorId], references: [id])

  studentId  String?
  student    Student? @relation(fields: [studentId], references: [id])
  groupId    String?
  group      Group?   @relation(fields: [groupId], references: [id])

  // Qaysi filial topshirig'i/eslatmasi (filial izolyatsiyasi; eski yozuvlarda null)
  branchId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, status])
  @@index([assigneeId])
}

// ─────────────────────────────────────────────────────────────
// O'QUV BO'LIMI — MAVSUMIY BAHOLASH VA SHARTNOMA
// ─────────────────────────────────────────────────────────────

// Mavsumiy baholash — fasl/chorak bo'yicha davriy baholash sessiyasi.
// (Har mavsumda guruh/daraja kesimida o'quvchilar baholanadi.)
model SeasonalAssessment {
  id        String   @id @default(cuid())
  title     String
  season    String // WINTER | SPRING | SUMMER | AUTUMN
  year      Int
  groupId   String?
  group     Group?   @relation(fields: [groupId], references: [id])
  levelCode String?
  skill     String? // SPEAKING | WRITING | READING | LISTENING | GRAMMAR | GENERAL
  maxScore  Int      @default(100)
  passScore Int      @default(60)
  date      DateTime?
  status    String   @default("PLANNED") // PLANNED | ONGOING | COMPLETED
  note      String?

  results   SeasonalResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([season, year])
  @@index([groupId])
}

model SeasonalResult {
  id           String   @id @default(cuid())
  assessmentId String
  assessment   SeasonalAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score        Int?
  grade        String? // A|B|C|D|F yoki daraja belgisi
  passed       Boolean?
  note         String?
  createdAt    DateTime @default(now())

  @@unique([assessmentId, studentId])
}

// Shartnoma shabloni — o'quv markazining shartnoma hujjatlari ro'yxati.
model ContractTemplate {
  id        String   @id @default(cuid())
  title     String // sarlavha
  type      String   @default("STANDARD") // STANDARD | ONLINE | OFFLINE | OFFER | INDIVIDUAL
  content   String? // shartnoma matni (shablon)
  note      String?
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
}

// Audit jurnali — o'chirib/tahrirlab bo'lmaydi (interfeys darajasida)
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String // CREATE | UPDATE | DELETE | CANCEL | LOGIN | ...
  entityType String // "Payment", "Lead", "Attendance", ...
  entityId   String?
  oldValue   String? // JSON
  newValue   String? // JSON
  reason     String? // qo'lda tuzatish sababi
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
}

// ─────────────────────────────────────────────────────────────
// QO'NG'IROQLAR MARKAZI (Call Center)
// Telefoniya integratsiyasi (Asterisk/SIP) keyingi bosqichda ulanadi;
// hozircha yozuvlar bazada saqlanadi va hisobotda ko'rsatiladi.
// ─────────────────────────────────────────────────────────────
model Call {
  id           String    @id @default(cuid())
  // Asterisk Linkedid/Uniqueid — CDR sinxronizatsiyasi bir xil qo'ng'iroqni
  // ikki marta yozmasligi uchun. Qo'lda yaratilgan yozuvlarda null.
  externalId   String?   @unique
  direction    String // INCOMING | OUTGOING
  status       String    @default("ANSWERED") // ANSWERED | MISSED | BUSY | NO_ANSWER | FAILED | CANCELLED

  // Operator (xodim) — snapshot nom bilan (xodim o'chirilsa ham qoladi)
  operatorId   String?
  operator     User?     @relation("CallOperator", fields: [operatorId], references: [id])
  operatorName String?

  // Abonent (lid yoki noma'lum raqam)
  leadId       String?
  lead         Lead?     @relation(fields: [leadId], references: [id])
  contactName  String? // abonent ismi (ma'lum bo'lsa)
  phone        String // abonent raqami

  duration     Int       @default(0) // sekund
  recordingUrl String? // audio yozuv manzili (bo'lmasa null)
  comment      String?

  callbackStatus String  @default("NONE") // NONE | PENDING | CALLED_BACK | NOT_NEEDED
  callbackAt     DateTime?

  startedAt    DateTime  @default(now())
  answeredAt   DateTime?
  endedAt      DateTime?
  createdAt    DateTime  @default(now())

  @@index([startedAt])
  @@index([status])
  @@index([direction])
  @@index([operatorId])
  @@index([callbackStatus])
}

// Xodim (o'qituvchi) reytingi — o'quvchi bahosi va izohi
model Feedback {
  id         String    @id @default(cuid())
  teacherId  String
  studentId  String?
  groupId    String?
  lessonDate DateTime?
  comment    String?
  rating     Int       @default(5) // 1..5
  createdAt  DateTime  @default(now())

  @@index([teacherId])
}

// ─────────────────────────────────────────────────────────────
// HAVOLALAR (Maxsus linklar) — vakansiya + platforma bo'yicha kuzatuv-havola
// Har havola /apply/<code> ga olib boradi; ko'rishlar va arizalar hisoblanadi.
// ─────────────────────────────────────────────────────────────
model Vacancy {
  id          String        @id @default(cuid())
  title       String // "qassobchilik", "Qurilish sohasi"
  company     String? // "GL", "BG GLOBAL", "MNG"
  country     String? // "Germaniya", "Bolgariya", "Mongoliya"
  countryCode String? // bayroq uchun: de | bg | mn ...
  jobTitle    String?
  salary      String?
  description String?
  // Ariza formasidagi qo'shimcha savollar — JSON massiv:
  // [{ q, type: "text"|"choice", options?: string[], required?: boolean }]
  questions   String?
  isActive    Boolean       @default(true)
  branchId    String?
  createdById String?
  createdByName String?
  links       VacancyLink[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([country])
}

model VacancyLink {
  id               String    @id @default(cuid())
  code             String    @unique // /apply/<code>
  name             String?
  platform         String    @default("other") // telegram|instagram|facebook|whatsapp|tiktok|youtube|linkedin|bio-link|other
  vacancyId        String
  vacancy          Vacancy   @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  views            Int       @default(0)
  submissions      Int       @default(0)
  isActive         Boolean   @default(true)
  expiresAt        DateTime?
  maxSubmissions   Int?
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  lastViewedAt     DateTime?
  lastSubmissionAt DateTime?
  createdById      String?
  createdByName    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([vacancyId])
  @@index([platform])
  @@index([isActive])
}

// Umumiy tizim sozlamalari (key-value) — telefoniya, biznes qoidalari va h.k.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// MOLIYA — XARAJATLAR (EXPENSES)
// ─────────────────────────────────────────────────────────────

// Xarajat turkumi (kategoriya) — "Kategoriya qo'shing" bilan yaratiladi
model ExpenseCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())

  expenses  Expense[]
}

// Xarajat yozuvi — talabaga bog'liq emas (Payment'dan farqli)
model Expense {
  id         String   @id @default(cuid())
  name       String // Nomi
  date       DateTime // Xarajat sanasi
  amount     Int // so'm (butun)
  method     String   @default("CASH") // CASH | PAYME | CARD | UZUM | CLICK | HUMO | BANK
  recipient  String? // Oluvchi
  note       String?

  categoryId String?
  category   ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Qaysi filial xarajati (filial izolyatsiyasi uchun; eski yozuvlarda null)
  branchId   String?

  authorId   String? // kiritgan xodim
  author     User?    @relation("ExpenseAuthor", fields: [authorId], references: [id])

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // ── Finance V2 (additive) ──
  financialAccountId String? // qaysi kassadan chiqqan
  financialAccount   FinancialAccount? @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  status             String   @default("ACTIVE") // ACTIVE | REVERSED (hard delete o'rniga)
  reversalOfId       String?  @unique
  reversalOf         Expense? @relation("ExpenseReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy         Expense? @relation("ExpenseReversal")
  idempotencyKey     String?  @unique
  receiptUrl         String?
  methodRaw          String? // normalizatsiyadan oldingi asl qiymat (masalan "HUMO")
  postedAt           DateTime? // ledgerga yozilgan vaqt (V2)

  @@index([date])
  @@index([categoryId])
  @@index([financialAccountId, date])
}

// ─────────────────────────────────────────────────────────────
// ISH HAQI — MAOSH KALKULYATORI QOIDALARI
// ─────────────────────────────────────────────────────────────

// Maosh hisoblash qoidasi (standart yoki individual).
// Nishon (o'qituvchi/kurs/guruh/talaba) denormalizatsiya bilan saqlanadi.
model SalaryRule {
  id         String   @id @default(cuid())
  // V2: GLOBAL | BRANCH | COURSE | GROUP | TEACHER | STUDENT (eski "ALL" = GLOBAL deb o'qiladi)
  scope      String   @default("ALL") // ALL | TEACHER | COURSE | GROUP | STUDENT
  // V2 compensation turi ham shu maydon: FIXED | PERCENT | (zaxira) PER_STUDENT | PER_LESSON | PER_HOUR
  amountType String   @default("FIXED") // FIXED (O'zgarmas) | PERCENT (Foiz)
  amount     Int // Miqdori (so'm yoki %) — V2'da FIXED uchun so'm; PERCENT uchun rateBp ishlatiladi
  isDefault  Boolean  @default(false) // 1-bosqich: barcha o'qituvchilar uchun standart
  targetId   String? // nishon id (teacher/program/group/student)
  targetName String? // ko'rsatish uchun nom
  createdAt  DateTime @default(now())

  // ── Finance V2 (additive). Qoida joyida O'ZGARTIRILMAYDI: yangi qator + eskisiga effectiveTo/supersededById ──
  policyId       String?
  policy         SalaryPolicy? @relation(fields: [policyId], references: [id], onDelete: Restrict)
  rateBp         Int? // PERCENT uchun basis point (4000 = 40%); legacy amount=40 → 4000
  effectiveFrom  DateTime? // oy boshi (Tashkent); eski qatorlarda null = createdAt oyi
  effectiveTo    DateTime?
  isActive       Boolean  @default(true)
  supersededById String?  @unique
  supersededBy   SalaryRule? @relation("RuleSupersede", fields: [supersededById], references: [id], onDelete: Restrict)
  supersedes     SalaryRule? @relation("RuleSupersede")
  note           String?
  createdById    String?
  createdBy      User?    @relation("SalaryRuleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  assignments GroupTeacherAssignment[] @relation("AssignmentRule")
  earnings    TeacherEarning[]         @relation("RuleEarnings")

  @@index([scope])
  @@index([scope, targetId, effectiveFrom])
  @@index([policyId])
}

// ── Market: o'quvchi yiqqan tangalarini sovg'aga almashtiradi ──
// Tanga balansi hisoblanadi (davomat + baholangan vazifalar), sarflangani
// esa MarketOrder yozuvlari yig'indisi bilan aniqlanadi.

model MarketItem {
  id          String  @id @default(cuid())
  title       String
  description String?
  price       Int // tangada
  imageUrl    String? // data URL yoki /uploads/...
  stock       Int? // null = cheklanmagan
  isActive    Boolean @default(true)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  orders    MarketOrder[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([isActive, branchId])
}

model MarketOrder {
  id     String @id @default(cuid())
  itemId String
  item   MarketItem @relation(fields: [itemId], references: [id])

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  price  Int // sotib olish paytidagi narx (keyin o'zgarsa ham hisob buzilmasin)
  status String @default("PENDING") // PENDING | DELIVERED | CANCELLED
  note   String?

  createdAt   DateTime  @default(now())
  deliveredAt DateTime?

  @@index([studentId, status])
  @@index([status])
}

// ── O'quvchi va ustoz yozishmasi ──
// Suhbat (studentId + teacherId) juftligi bilan aniqlanadi. Ustoz almashsa
// eski yozishma saqlanib qoladi, yangi suhbat ochiladi.

model ChatMessage {
  id String @id @default(cuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  teacherId String?
  teacher   User?   @relation("ChatTeacher", fields: [teacherId], references: [id])

  fromStudent Boolean // true — o'quvchi yozgan, false — ustoz/ma'muriyat
  authorId    String? // aslida kim yozgani (ustoz o'rniga menejer ham javob berishi mumkin)
  author      User?   @relation("ChatAuthor", fields: [authorId], references: [id])

  text   String
  readAt DateTime? // qarshi tomon o'qigan vaqti

  createdAt DateTime @default(now())

  @@index([studentId, createdAt])
  @@index([teacherId, fromStudent, readAt])
}

// ── "Ikkinchi miya" (Zweites Gehirn) — o'quvchining shaxsiy bilim bazasi ──
// Obsidian uslubi: har yozuv sarlavha bilan ataladi, matn ichida [[Sarlavha]]
// yozilsa boshqa yozuvga bog'lanadi. Bog'lanishlar ALOHIDA jadvalda emas —
// matndan o'qib olinadi, shunda ular hamisha matn bilan mos bo'ladi va
// hali yaratilmagan yozuvga ham havola qilish mumkin (Obsidian'dagidek).

model Note {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  title   String
  content String  @default("")
  // Vergul bilan ajratilgan teglar (#teg matndan ham yig'iladi)
  tags    String?
  // Yo'nalish/kategoriya — grafda rang beradi
  kind    String  @default("NOTE") // NOTE | IDEA | GOAL | BOOK | PERSON | DAILY
  pinned  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Sarlavha o'quvchi doirasida noyob — [[havola]] shu bo'yicha topiladi
  @@unique([studentId, title])
  @@index([studentId, updatedAt])
}

// ════════════════════════════════════════════════════════════════════
// FINANCE V2 (Phase 1 — schema). Reja: ~/Desktop/G-LIVE-FINANCE-V2-PLAN.md
//
// Konvensiya: enum yo'q (String + lib/finance/constants.ts), pul Int so'm,
// foiz Int basis point (40% = 4000), snapshot String (JSON matn) — SQLite va
// Postgres'da bir xil ishlaydi. Balans hech qaerda SAQLANMAYDI — ledger va
// allocation qatorlaridan hisoblanadi.
//
// Tarixiy jadvallar (FinancialTransaction, PaymentAllocation, TeacherEarning,
// Refund, SalaryPayout, Transfer) IMMUTABLE: update/delete yo'q, tuzatish =
// teskari (reversal) qator. Shu sabab ularda updatedAt YO'Q, aktor (createdBy)
// esa Restrict — foydalanuvchini o'chirish tarixiy qatorni o'zgartira olmaydi
// (xodim arxivlanadi, o'chirilmaydi).
//
// Sana semantikasi (aralashtirilmaydi):
//   service period   — StudentCharge.serviceYear/serviceMonth (xizmat oyi)
//   receivedAt       — Payment.receivedAt (pul real kelgan vaqt)
//   earning month    — TeacherEarning.earningYear/earningMonth = receivedAt oyi
//   settlement       — TeacherEarning.settlementPeriodId (qaysi maoshda to'lanadi)
//   payout date      — SalaryPayout.paidAt
//   createdAt        — yozuv yaratilgan vaqt
// ════════════════════════════════════════════════════════════════════

// ─── Kassa / hisob: pul qayerda turadi (to'lov usuli EMAS) ───
model FinancialAccount {
  id             String   @id @default(cuid())
  branchId       String?
  branch         Branch?  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  name           String
  type           String // FINANCIAL_ACCOUNT_TYPES: MAIN_CASH | CLICK | PAYME | UZUM | TERMINAL | BANK | CUSTOM
  isActive       Boolean  @default(true)
  // Ochilish balansi TARIXIY FAKT: manba — ledgerdagi type=OPENING_BALANCE qatori
  // (referenceType "FinancialAccount", referenceId = shu id, occurredAt = openingAt).
  // Bu ikki ustun yaratilish paytidagi snapshot — service qatlami ularni HECH QACHON
  // update qilmaydi (3 oydan keyin "opening"ni tahrirlab tarixiy balans o'zgarmasin).
  // Balans = Σ IN − Σ OUT (ledger, opening qatori ham ichida).
  openingBalance Int      @default(0)
  openingAt      DateTime @default(now())
  note           String?
  createdById    String?
  createdBy      User?    @relation("FinancialAccountCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  transactions  FinancialTransaction[]
  payments      Payment[]
  expenses      Expense[]
  refunds       Refund[]
  payouts       SalaryPayout[]
  transfersFrom Transfer[] @relation("TransferFrom")
  transfersTo   Transfer[] @relation("TransferTo")

  @@index([branchId, type])
}

// ─── Yagona pul harakati jurnali (immutable) ───
model FinancialTransaction {
  id             String   @id @default(cuid())
  branchId       String?
  branch         Branch?  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  accountId      String
  account        FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  type           String // LEDGER_TYPES: OPENING_BALANCE | STUDENT_PAYMENT | EXPENSE | SALARY_PAYOUT | REFUND | TRANSFER_IN | TRANSFER_OUT | ADJUSTMENT | OTHER_INCOME
  direction      String // IN | OUT
  amount         Int // so'm, > 0
  referenceType  String // FinancialAccount (opening) | Payment | Expense | SalaryPayout | Refund | Transfer | Adjustment
  referenceId    String
  sequence       Int      @default(0) // bir reference ichida bir nechta qator (split) uchun tartib
  // Manba hujjatning biznes sanasi: Payment.receivedAt · Expense.date · SalaryPayout.paidAt · Refund.refundedAt · Transfer.occurredAt
  occurredAt     DateTime // pul real harakat qilgan vaqt
  note           String?
  idempotencyKey String   @unique
  createdById    String?
  createdBy      User?    @relation("LedgerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime @default(now())

  @@unique([referenceType, referenceId, accountId, direction, sequence])
  @@index([accountId, occurredAt])
  @@index([branchId, occurredAt])
  @@index([referenceType, referenceId])
}

// ─── Kassalar orasida o'tkazma (xarajat EMAS) — ledgerda OUT + IN ───
model Transfer {
  id             String   @id @default(cuid())
  fromAccountId  String
  fromAccount    FinancialAccount @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccountId    String
  toAccount      FinancialAccount @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Restrict)
  amount         Int
  occurredAt     DateTime
  note           String?
  status         String   @default("DONE") // DONE | REVERSED
  reversalOfId   String?  @unique
  reversalOf     Transfer? @relation("TransferReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy     Transfer? @relation("TransferReversal")
  idempotencyKey String   @unique
  createdById    String?
  createdBy      User?    @relation("TransferCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime @default(now())

  @@index([occurredAt])
}

// ─── Hisob-kitob siyosati (versiyali; joyida o'zgartirilmaydi) ───
model BillingPolicy {
  id                  String   @id @default(cuid())
  name                String
  branchId            String?
  branch              Branch?  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  version             Int      @default(1)
  effectiveFrom       DateTime // oy boshi (Tashkent)
  effectiveTo         DateTime?
  isActive            Boolean  @default(true)
  midMonthJoinMode    String   @default("FULL_MONTH") // FULL_MONTH | (zaxira) PRO_RATA_DAYS | PRO_RATA_LESSONS
  dueDay              Int      @default(1) // xizmat oyining qaysi kuni muddat
  frozenFullMonthMode String   @default("ZERO_CHARGE") // to'liq oy FROZEN bo'lsa: ZERO_CHARGE
  noEnrollmentMode    String   @default("NO_CHARGE") // guruh a'zoligisiz oy: NO_CHARGE
  note                String?
  createdById         String?
  createdBy           User?    @relation("BillingPolicyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt           DateTime @default(now())

  charges StudentCharge[]

  @@unique([name, version])
  @@index([branchId, effectiveFrom])
}

// ─── O'quvchi majburiyati (invoice): qaysi oy uchun qancha to'lashi kerak ───
model StudentCharge {
  id              String   @id @default(cuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  branchId        String?
  branch          Branch?  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  groupId         String?
  group           Group?   @relation(fields: [groupId], references: [id], onDelete: Restrict)
  programId       String?
  program         Program? @relation(fields: [programId], references: [id], onDelete: Restrict)
  billingPolicyId String?
  billingPolicy   BillingPolicy? @relation(fields: [billingPolicyId], references: [id], onDelete: Restrict)
  kind            String // CHARGE_KINDS: MONTHLY | MANUAL_DEBT | OPENING_BALANCE | ADJUSTMENT
  serviceYear     Int
  serviceMonth    Int // 1-12
  originalAmount  Int
  discountAmount  Int      @default(0)
  finalAmount     Int // = originalAmount − discountAmount
  dueDate         DateTime
  // Holat allocation qatorlaridan hisoblanadi va shu yerda saqlanadi (ro'yxatlar uchun);
  // to'langan summa saqlanmaydi — Σ ALLOCATION − Σ REVERSAL.
  status          String   @default("OPEN") // CHARGE_STATUSES: OPEN | PARTIALLY_PAID | PAID | WAIVED | CANCELLED
  cancelledAt     DateTime?
  cancelReason    String?
  cancelledById   String?
  cancelledBy     User?    @relation("ChargeCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  // Eski PENDING (qo'lda qarz) Payment qatoridan ko'chirilgan bo'lsa — manba
  legacyPaymentId String?  @unique
  legacyPayment   Payment? @relation("ChargeLegacyPayment", fields: [legacyPaymentId], references: [id], onDelete: Restrict)
  // MONTHLY: `${studentId}:${groupId}:${YYYY}-${MM}` — bir oyga ikki marta yozilmaydi.
  // ADJUSTMENT/almashtiruvchi: `${asl chargeKey}:adj:${o'z id}` — MAX(N)+1 emas, poyga xavfsiz.
  chargeKey       String   @unique
  // Lineage (D3): bekor qilingan charge qayta tiriltirilmaydi — yangi charge uni ALMASHTIRADI
  // (replacesChargeId, one-to-one) yoki TUZATADI (adjustsChargeId, one-to-many).
  replacesChargeId String? @unique
  replacesCharge   StudentCharge?  @relation("ChargeReplaces", fields: [replacesChargeId], references: [id], onDelete: Restrict)
  replacedBy       StudentCharge?  @relation("ChargeReplaces")
  adjustsChargeId  String?
  adjustsCharge    StudentCharge?  @relation("ChargeAdjusts", fields: [adjustsChargeId], references: [id], onDelete: Restrict)
  adjustments      StudentCharge[] @relation("ChargeAdjusts")
  // Snapshot IMMUTABLE: chegirma hisobi (StudentDiscount o'sha paytdagi holati), narx manbai,
  // a'zolik/holat intervallari, siyosat. Keyin discount o'zgarsa bu invoice o'zgarmaydi — correction = adjustment.
  snapshot        String? // JSON
  note            String?
  createdById     String?
  createdBy       User?    @relation("ChargeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  allocations PaymentAllocation[]
  earnings    TeacherEarning[]

  @@index([studentId, serviceYear, serviceMonth])
  @@index([groupId, serviceYear, serviceMonth])
  @@index([branchId, serviceYear, serviceMonth])
  @@index([status, dueDate])
  @@index([adjustsChargeId])
}

// ─── O'quvchi chegirmasi (charge yaratilganda qo'llanadi) ───
model StudentDiscount {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  groupId       String? // null = o'quvchining barcha guruhlari
  group         Group?   @relation(fields: [groupId], references: [id], onDelete: Restrict)
  type          String // PERCENT (value = bp) | FIXED (value = so'm)
  value         Int
  effectiveFrom DateTime
  effectiveTo   DateTime?
  isActive      Boolean  @default(true)
  reason        String
  createdById   String?
  createdBy     User?    @relation("DiscountCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@index([studentId, effectiveFrom])
}

// ─── To'lovning majburiyatga taqsimoti (IMMUTABLE tarix) ───
// paymentId — HAR DOIM manba to'lov (kredit qo'llanganda ham). Tuzatish:
// kind=REVERSAL qatori (reversalOfId asl qatorga), keyin yangi ALLOCATION.
// remaining(charge) = finalAmount − Σ ALLOCATION + Σ REVERSAL.
model PaymentAllocation {
  id             String   @id @default(cuid())
  paymentId      String
  payment        Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  chargeId       String
  charge         StudentCharge @relation(fields: [chargeId], references: [id], onDelete: Restrict)
  amount         Int // > 0 (yo'nalish kind bilan)
  kind           String // ALLOCATION | REVERSAL
  reversalOfId   String?
  reversalOf     PaymentAllocation?  @relation("AllocationReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals      PaymentAllocation[] @relation("AllocationReversal")
  refundId       String? // REVERSAL refund natijasi bo'lsa
  refund         Refund?  @relation(fields: [refundId], references: [id], onDelete: Restrict)
  source         String // ALLOCATION_SOURCES: AUTO_FIFO | CREDIT_APPLY | MANUAL | BACKFILL
  allocatedAt    DateTime @default(now()) // texnik vaqt — earning sanasi EMAS
  idempotencyKey String   @unique
  createdById    String?
  createdBy      User?    @relation("AllocationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime @default(now())

  earnings TeacherEarning[]

  @@index([paymentId])
  @@index([chargeId])
  @@index([refundId])
}

// ─── Qaytarim (Payment statusini o'zgartirmaydi; alohida tarixiy fakt) ───
model Refund {
  id                 String   @id @default(cuid())
  originalPaymentId  String? // faqat LEGACY (eski "yechib olish") uchun null
  originalPayment    Payment? @relation("PaymentRefunds", fields: [originalPaymentId], references: [id], onDelete: Restrict)
  studentId          String
  student            Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  branchId           String?
  branch             Branch?  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  amount             Int
  reason             String
  financialAccountId String
  financialAccount   FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  refundedAt         DateTime
  // CASH_REFUND — o'quvchiga real pul qaytdi; CORRECTION — xato kiritilgan to'lovni bekor qilish (reversePayment)
  kind               String   @default("CASH_REFUND") // CASH_REFUND | CORRECTION
  status             String   @default("DONE") // DONE | REVERSED
  reversalOfId       String?  @unique // xato kiritilgan qaytarimni bekor qiluvchi qator (tarix o'chirilmaydi)
  reversalOf         Refund?  @relation("RefundReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy         Refund?  @relation("RefundReversal")
  source             String   @default("V2") // V2 | LEGACY
  legacyPaymentId    String?  @unique // eski REFUNDED Payment qatori
  legacyPayment      Payment? @relation("RefundLegacyPayment", fields: [legacyPaymentId], references: [id], onDelete: Restrict)
  idempotencyKey     String   @unique
  createdById        String?
  createdBy          User?    @relation("RefundCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt          DateTime @default(now())

  reversalAllocations PaymentAllocation[] // kind=REVERSAL qatorlar
  earnings            TeacherEarning[] // REFUND_ADJUSTMENT qatorlar

  @@index([originalPaymentId])
  @@index([studentId, refundedAt])
}

// ─── O'qituvchi tayinlash TARIXI (Group.teacherId faqat joriy holat) ───
model GroupTeacherAssignment {
  id                 String   @id @default(cuid())
  groupId            String
  group              Group    @relation(fields: [groupId], references: [id], onDelete: Restrict)
  teacherId          String
  teacher            User     @relation("TeacherAssignments", fields: [teacherId], references: [id], onDelete: Restrict)
  role               String   @default("MAIN") // MAIN | ASSISTANT
  // REAL sana intervali (D1): oy boshiga majburan tenglashtirilmaydi — 1–15 A, 16–30 B saqlanadi.
  // Bir oyda ikki MAIN bo'lsa bo'linish SalaryPolicy.assignmentSplitMode bilan (default REVIEW).
  effectiveFrom      DateTime
  effectiveTo        DateTime?
  compensationRuleId String? // assignment darajasidagi qoida (ASSISTANT uchun odatda shart)
  compensationRule   SalaryRule? @relation("AssignmentRule", fields: [compensationRuleId], references: [id], onDelete: Restrict)
  source             String   @default("KNOWN") // KNOWN | INFERRED (cutover'gacha Group.teacherId dan — moliyaviy fakt EMAS)
  note               String?
  createdById        String?
  createdBy          User?    @relation("AssignmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime @default(now())

  earnings TeacherEarning[]

  @@index([groupId, effectiveFrom])
  @@index([teacherId, effectiveFrom])
}

// ─── O'quvchi holati tarixi (FROZEN/ARCHIVED oylari uchun; cutover'dan yuritiladi) ───
model StudentStatusHistory {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status        String // EDU_STATUSES
  effectiveFrom DateTime
  effectiveTo   DateTime?
  reason        String?
  createdById   String?
  createdBy     User?    @relation("StatusHistoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@index([studentId, effectiveFrom])
}

// ─── O'quvchining guruh a'zoligi TARIXI (D4) — billing uchun source-of-truth ───
// `GroupStudent` operatsion holat (unique(group, student) — chiqib qayta kirsa eski
// interval yo'qoladi). Bu jadval har intervalni alohida saqlaydi; cutover'dan keyingi
// a'zolik o'zgarishlari shu yerga deterministik yoziladi. Legacy intervallar
// backfill'da source=INFERRED (GroupStudent.joinedAt/leftAt dan), noaniq bo'lsa NEEDS_REVIEW.
model GroupStudentHistory {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  groupId       String
  group         Group    @relation(fields: [groupId], references: [id], onDelete: Restrict)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  source        String   @default("KNOWN") // KNOWN | INFERRED | NEEDS_REVIEW
  note          String?
  createdById   String?
  createdBy     User?    @relation("GroupStudentHistoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@index([studentId, effectiveFrom])
  @@index([groupId, effectiveFrom])
}

// ─── Maosh siyosati (versiyali; eski versiya mutate qilinmaydi) ───
model SalaryPolicy {
  id                         String   @id @default(cuid())
  name                       String
  branchId                   String?
  branch                     Branch?  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  version                    Int      @default(1)
  effectiveFrom              DateTime // oy boshi (Tashkent)
  effectiveTo                DateTime?
  isActive                   Boolean  @default(true)
  salaryBaseMode             String   @default("REAL_PAID_AMOUNT") // REAL_PAID_AMOUNT | FULL_PRICE_EQUIVALENT
  attendanceMode             String   @default("NONE") // NONE | PRESENT_RATIO
  attendanceCountedStatuses  String   @default("PRESENT,LATE,ONLINE,MAKEUP") // vergul bilan
  requireConfirmedAttendance Boolean  @default(false) // faqat ustoz tasdiqlagan davomat
  noLessonsMode              String   @default("NO_LESSONS_REVIEW") // NO_LESSONS_REVIEW | (zaxira) NO_LESSONS_AS_FULL | NO_LESSONS_AS_ZERO
  // D1: bir xizmat oyida MAIN o'qituvchi almashsa (1–15 A, 16–30 B) commission qanday bo'linadi.
  // REVIEW (default) — avtomatik ikki to'liq commission TAQIQ, earning NEEDS_REVIEW; zaxira: SERVICE_DAYS_RATIO | LESSONS_RATIO | MANUAL_SPLIT
  assignmentSplitMode        String   @default("REVIEW")
  includeArchivedStudents    Boolean  @default(true)
  includeFrozenStudents      Boolean  @default(true)
  includeZeroAmounts         Boolean  @default(false)
  note                       String?
  createdById                String?
  createdBy                  User?    @relation("SalaryPolicyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt                  DateTime @default(now())

  rules    SalaryRule[]
  earnings TeacherEarning[]

  @@unique([name, version])
  @@index([branchId, effectiveFrom])
}

// ─── O'qituvchi ulushi — maosh dvigatelining manbai (IMMUTABLE) ───
// Bir allocation × bir assignment × tur = bitta qator (idempotencyKey +
// @@unique). Tuzatish — teskari qator (REFUND_ADJUSTMENT / MANUAL_ADJUSTMENT).
// Summalar/sanalar hech qachon o'zgarmaydi. Ruxsat etilgan yagona o'zgarishlar:
//   • status NEEDS_REVIEW → POSTED (+ reviewedAt/reviewedById, audit bilan)
//   • settlementPeriodId — POSTED bo'lganda yoki keyingi ochiq davrga o'tkazilganda
model TeacherEarning {
  id                 String   @id @default(cuid())
  teacherId          String
  teacher            User     @relation("TeacherEarnings", fields: [teacherId], references: [id], onDelete: Restrict)
  studentId          String?
  student            Student? @relation(fields: [studentId], references: [id], onDelete: Restrict)
  // Pul manbai — PAYMENT_COMMISSION uchun majburiy (kredit qo'llanganda ham asl to'lov)
  sourcePaymentId    String?
  sourcePayment      Payment? @relation("PaymentEarnings", fields: [sourcePaymentId], references: [id], onDelete: Restrict)
  allocationId       String?
  allocation         PaymentAllocation? @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  chargeId           String?
  charge             StudentCharge? @relation(fields: [chargeId], references: [id], onDelete: Restrict)
  refundId           String?
  refund             Refund?  @relation(fields: [refundId], references: [id], onDelete: Restrict)
  groupId            String?
  group              Group?   @relation(fields: [groupId], references: [id], onDelete: Restrict)
  programId          String?
  program            Program? @relation(fields: [programId], references: [id], onDelete: Restrict)
  branchId           String?
  branch             Branch?  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  policyId           String?
  policy             SalaryPolicy? @relation(fields: [policyId], references: [id], onDelete: Restrict)
  ruleId             String?
  rule               SalaryRule? @relation("RuleEarnings", fields: [ruleId], references: [id], onDelete: Restrict)
  assignmentId       String?
  assignment         GroupTeacherAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  // Sanalar (7.0): xizmat oyi · pul kelgan vaqt · earning oyi (= receivedAt oyi) · settlement
  serviceYear        Int?
  serviceMonth       Int?
  receivedAt         DateTime?
  earningYear        Int
  earningMonth       Int // 1-12
  settlementPeriodId String?
  settlementPeriod   SalaryPeriod? @relation(fields: [settlementPeriodId], references: [id], onDelete: Restrict)
  baseAmount         Int      @default(0)
  eligibleAmount     Int      @default(0)
  rateBp             Int? // PERCENT uchun (4000 = 40%)
  amount             Int // manfiy bo'lishi mumkin (adjustment)
  type               String // EARNING_TYPES: PAYMENT_COMMISSION | FIXED | BONUS | KPI | PENALTY | REFUND_ADJUSTMENT | MANUAL_ADJUSTMENT
  status             String   @default("POSTED") // POSTED | NEEDS_REVIEW
  reviewReason       String? // NO_LESSONS_FOUND | ASSISTANT_NO_RULE | RATE_SUM_EXCEEDED | LEGACY_INFERRED
  reviewedAt         DateTime?
  reviewedById       String?
  reviewedBy         User?    @relation("EarningReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  snapshot           String // JSON: policy, rule, assignment, charge, allocation, sourcePayment, attendance, base, eligible, tz
  idempotencyKey     String   @unique
  reversalOfId       String?
  reversalOf         TeacherEarning?  @relation("EarningReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals          TeacherEarning[] @relation("EarningReversal")
  note               String?
  createdById        String?
  createdBy          User?    @relation("EarningCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt          DateTime @default(now())

  // DB darajasida dublikat commission taqiqlanadi (idempotencyKey formatidan mustaqil).
  // allocationId null bo'lgan turlar (FIXED, BONUS…) uchun SQLite/Postgres NULL'larni farqli hisoblaydi — cheklov faqat commission'ga ta'sir qiladi.
  @@unique([allocationId, assignmentId, type])
  @@index([teacherId, earningYear, earningMonth])
  @@index([settlementPeriodId])
  @@index([status])
  @@index([sourcePaymentId])
  @@index([allocationId])
  @@index([studentId])
}

// ─── Maosh davri (snapshot; manba — TeacherEarning va SalaryPayout) ───
model SalaryPeriod {
  id                    String   @id @default(cuid())
  teacherId             String
  teacher               User     @relation("TeacherSalaryPeriods", fields: [teacherId], references: [id], onDelete: Restrict)
  year                  Int
  month                 Int // 1-12
  status                String   @default("OPEN") // SALARY_PERIOD_STATUSES: OPEN | CALCULATED | APPROVED | PARTIALLY_PAID | PAID | CLOSED
  fixedAmount           Int      @default(0)
  commissionAmount      Int      @default(0)
  bonusAmount           Int      @default(0)
  kpiAmount             Int      @default(0)
  penaltyAmount         Int      @default(0)
  adjustmentAmount      Int      @default(0)
  grossAmount           Int      @default(0)
  paidAmount            Int      @default(0)
  remainingAmount       Int      @default(0)
  calculatedAt          DateTime?
  approvedAt            DateTime?
  approvedById          String?
  approvedBy            User?    @relation("PeriodApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  closedAt              DateTime?
  closedById            String?
  closedBy              User?    @relation("PeriodClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  reopenedAt            DateTime?
  reopenedById          String?
  reopenedBy            User?    @relation("PeriodReopenedBy", fields: [reopenedById], references: [id], onDelete: SetNull)
  reopenReason          String?
  source                String   @default("V2") // V2 | LEGACY
  legacyFiksaAmount     Int? // eski TeacherSalary.fiksa (ichida commission ham bo'lishi mumkin — ajratilmaydi)
  legacyTeacherSalaryId String?  @unique
  legacyTeacherSalary   TeacherSalary? @relation(fields: [legacyTeacherSalaryId], references: [id], onDelete: Restrict)
  note                  String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  earnings TeacherEarning[]
  payouts  SalaryPayout[]

  @@unique([teacherId, year, month])
  @@index([year, month])
  @@index([status])
}

// ─── Maosh to'lovi (qo'lda, qisman bo'lishi mumkin) — ledger OUT ───
model SalaryPayout {
  id                 String   @id @default(cuid())
  teacherId          String
  teacher            User     @relation("TeacherPayouts", fields: [teacherId], references: [id], onDelete: Restrict)
  salaryPeriodId     String
  salaryPeriod       SalaryPeriod @relation(fields: [salaryPeriodId], references: [id], onDelete: Restrict)
  financialAccountId String
  financialAccount   FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  branchId           String?
  branch             Branch?  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  amount             Int
  paidAt             DateTime
  note               String?
  status             String   @default("DONE") // DONE | REVERSED
  reversalOfId       String?  @unique
  reversalOf         SalaryPayout? @relation("PayoutReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy         SalaryPayout? @relation("PayoutReversal")
  idempotencyKey     String   @unique
  createdById        String?
  createdBy          User?    @relation("PayoutCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt          DateTime @default(now())

  @@index([teacherId, paidAt])
  @@index([salaryPeriodId])
}

// ─── Moliya davri qulfi (to'lov/xarajat/qaytarim uchun; maosh davri alohida) ───
model FinancePeriodLock {
  id           String   @id @default(cuid())
  branchId     String? // null = butun tizim
  branch       Branch?  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  year         Int
  month        Int // 1-12
  isLocked     Boolean  @default(true)
  lockedAt     DateTime @default(now())
  lockedById   String?
  lockedBy     User?    @relation("PeriodLockedBy", fields: [lockedById], references: [id], onDelete: SetNull)
  reason       String
  reopenedAt   DateTime?
  reopenedById String?
  reopenedBy   User?    @relation("PeriodLockReopenedBy", fields: [reopenedById], references: [id], onDelete: SetNull)
  reopenReason String?
  // SQLite'da unique ichidagi NULL takrorlanaveradi — shu sabab kalit: `${branchId ?? "-"}:${YYYY}-${MM}`
  lockKey      String   @unique

  @@index([year, month])
}
